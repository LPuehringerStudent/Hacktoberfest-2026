# Copy to .env and fill in. Never commit .env.

# Gemma 4 via the Gemini API — https://aistudio.google.com/apikey
# MODEL_BASE_URL: self-hosted llama-server (default on the server) or Gemini's OpenAI-compatible endpoint as fallback
MODEL_BASE_URL=http://127.0.0.1:8080/v1
# Only needed for the Gemini fallback
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# Shared secret for the ElevenLabs custom LLM (set the same value as the agent's API key secret)
RELAY_TOKEN=

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Backend listener
HOST=127.0.0.1
PORT=8000

# Extra CORS origins for the backend (Lovable's *.lovable.app / *.lovableproject.com are allowed by default)
CORS_ORIGINS=https://hacktober.lpuehringer.dev,http://localhost:5173
